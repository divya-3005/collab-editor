{
  "name": "collabdocs-server",
  "version": "1.0.0",
  "description": "Real-time collaborative text editor backend powered by Express, Socket.io, and ProseMirror step-based OT.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "echo \"No build step required for Node.js backend\"",
